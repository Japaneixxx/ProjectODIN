<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/odin_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/odin_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivListPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/odin_surface_variant"
                android:scaleType="centerCrop"
                app:cornerSize="8dp"
                app:strokeColor="@color/odin_border"
                app:strokeWidth="1dp"
                tools:src="@android:drawable/sym_def_app_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIndexNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/odin_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="#0001" />

            <TextView
                android:id="@+id/tvMainName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/odin_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Alemão" />

            <TextView
                android:id="@+id/tvSubName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/odin_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Carlos Eduardo"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRelationshipBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_type_badge"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/odin_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="AMIGO" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>