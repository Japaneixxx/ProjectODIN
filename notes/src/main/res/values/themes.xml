<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ODIN" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cores Primárias -->
        <item name="colorPrimary">@color/odin_primary</item>
        <item name="colorOnPrimary">@color/odin_on_primary</item>

        <!-- Fundos e Superfícies -->
        <item name="android:colorBackground">@color/odin_background</item>
        <item name="colorSurface">@color/odin_surface</item>

        <!-- Status Bar e Navigation Bar -->
        <item name="android:statusBarColor">@color/odin_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/odin_background</item>
    </style>
</resources>